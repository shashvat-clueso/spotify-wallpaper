        { "value": "blue", "label": "Blue" },
        { "value": "red", "label": "Red" },
        { "value": "magenta", "label": "Magenta" },
        { "value": "green", "label": "Green" }
      ]
    },
    {
      "key": "banner",
      "type": "select",
      "label": "Banner",
      "default": "genre",
      "options": [
        { "value": "genre", "label": "The song's genre" },
        { "value": "music", "label": "MUSIC" },
        { "value": "none", "label": "None" }
      ]
    },
    {
      "key": "doubleHeight",
      "type": "bool",
      "label": "Current line in double height",
