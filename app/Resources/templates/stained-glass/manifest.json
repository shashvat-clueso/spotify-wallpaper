{
  "name": "Stained Glass",
  "description": "The cover cut into a window of glass panes, smaller where the cover has detail, joined with lead and lit by slow-moving light. Each new line sets one pane glowing, and the lyric sits on a parchment banner.",
  "author": "Built-in",
  "category": "painting",
  "params": [
    { "key": "panes", "type": "int", "label": "Panes", "min": 120, "max": 900, "default": 380 },
    { "key": "detail", "type": "number", "label": "Smaller panes in detail", "min": 0, "max": 1, "step": 0.05, "default": 0.8 },
    { "key": "richness", "type": "number", "label": "Glass colour", "min": 0.6, "max": 2, "step": 0.05, "default": 1.35 },
    { "key": "lead", "type": "color", "label": "Lead", "default": "#16110F" },
    { "key": "leadWidth", "type": "number", "label": "Lead width", "min": 0.15, "max": 1.2, "step": 0.05, "default": 0.55 },
    { "key": "parchment", "type": "color", "label": "Banner", "default": "#EFE2C2" },
    { "key": "ink", "type": "color", "label": "Banner ink", "default": "#3B2414" },
    { "key": "face", "type": "select", "label": "Banner type", "default": "hoefler",
      "options": [
        { "value": "hoefler", "label": "Hoefler Text" },
        { "value": "baskerville", "label": "Baskerville" },
        { "value": "iowan", "label": "Iowan Old Style" },
        { "value": "palatino", "label": "Palatino" }
      ] },
    { "key": "rays", "type": "bool", "label": "Moving light", "default": true },
    { "key": "glow", "type": "bool", "label": "Glow a pane each line", "default": true }
  ]
}
