{
  "name": "Liner Notes",
  "description": "The CD booklet, open: the cover printed on one page and the whole song typeset on the other, the sung line marked like you'd mark it in pencil.",
  "author": "Built-in",
  "category": "print",
  "params": [
    { "key": "paper", "type": "color", "label": "Paper", "default": "auto:paper" },
    { "key": "ink", "type": "color", "label": "Ink", "default": "#221F1B" },
    { "key": "accent", "type": "color", "label": "Ornaments", "default": "auto:vibrant" },
    { "key": "marker", "type": "color", "label": "Marker", "default": "auto:vibrant" },
    { "key": "font", "type": "font", "label": "Typeface", "default": "Baskerville" },
    { "key": "maxSize", "type": "number", "label": "Largest lyric size", "min": 1.6, "max": 5, "step": 0.1, "unit": "vmin", "default": 2.9 },
    { "key": "columns", "type": "int", "label": "Most columns", "min": 1, "max": 4, "default": 3 },
    { "key": "translations", "type": "bool", "label": "Show translations", "default": true },
    { "key": "verseNumbers", "type": "bool", "label": "Verse numbers", "default": true },
    { "key": "fold", "type": "bool", "label": "Center fold", "default": true },
    { "key": "grain", "type": "bool", "label": "Paper grain", "default": true }
  ]
}
