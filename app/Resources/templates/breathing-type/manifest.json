{
  "name": "Breathing Type",
  "description": "The line's key word set huge in a variable font whose width swells and contracts with the beat; the rest of the line sits small and thin around it.",
  "author": "Built-in",
  "category": "lyrics",
  "params": [
    {
      "key": "background",
      "type": "color",
      "label": "Background",
      "default": "auto:dark"
    },
    {
      "key": "glow",
      "type": "color",
      "label": "Glow",
      "default": "auto:deep"
    },
    {
      "key": "hero",
      "type": "color",
      "label": "Key word",
      "default": "auto:vibrant"
    },
    {
      "key": "text",
      "type": "color",
      "label": "Other words",
      "default": "#F6EEE6"
    },
    {
      "key": "tempo",
      "type": "int",
      "label": "Breathing tempo without beat sync (BPM)",
      "min": 40,
      "max": 160,
      "default": 72
    },
    {
      "key": "depth",
      "type": "number",
      "label": "Breath depth",
      "min": 0.2,
      "max": 1.5,
      "step": 0.05,
      "default": 1
    },
    {
      "key": "weight",
      "type": "int",
      "label": "Key word weight",
      "min": 300,
      "max": 1000,
      "step": 50,
      "default": 860
    },
    {
      "key": "grain",
      "type": "bool",
      "label": "Film grain",
      "default": true
    }
  ]
}
